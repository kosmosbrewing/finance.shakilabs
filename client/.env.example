VITE_GA_MEASUREMENT_ID=        # Google Analytics 4
VITE_SENTRY_DSN=
VITE_GA_DEBUG=false
VITE_AD_PROVIDER=adsense       # adsense | adfit | none — 한 시점에 하나만. 오타는 none으로 떨어진다
VITE_ADSENSE_PUBLISHER_ID=     # AdSense (ca-pub-...). provider=adsense일 때만 필요
# 애드핏 유닛 ID는 환경변수가 아니라 src/config/adUnits.ts에 적는다 — 슬롯마다 다르고 공개값이다
VITE_SITE_URL=https://shakilabs.com/finance
VITE_KAKAO_JS_KEY=             # KakaoTalk 공유
VITE_KAKAO_ALLOWED_HOSTS=shakilabs.com
